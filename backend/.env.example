# --- NTA GTFS-Realtime v2 (https://developer.nationaltransport.ie) ---
# Auth header is x-api-key (NOT Ocp-Apim-Subscription-Key). ~15 min to activate after subscribing.
NTA_API_KEY=your-nta-key-here
NTA_API_KEY_SECONDARY=
NTA_BASE_URL=https://api.nationaltransport.ie/gtfsr/v2

JEV_API_KEY=paste-your-jev-key-here
JEV_MODEL=jev-latest

# --- Cohort health thresholds (policy lives in code/env, never in a model) ---
# Provisional; set from the step-1 probe. Units: seconds / fraction / count.
MAX_ENTITY_AGE_SECS=120
MAX_FEED_AGE_SECS=90
MAX_SKEW_SECS=30
MIN_OBSERVED_FRACTION=0.30
MIN_ABS_FLOOR=20
COLDSTART_N=3

# --- CORS: your Vercel frontend origin ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Database (Neon Postgres). OFF by default. Build-plan step 2+. ---
USE_DB=false
# POOLED url (app queries) — hostname has -pooler:
DATABASE_URL=
# DIRECT url (migrations only) — no -pooler:
DATABASE_URL_DIRECT=
